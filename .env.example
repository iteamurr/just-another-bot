# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=spacedreader
POSTGRES_USER=spacedreader
POSTGRES_PASSWORD=spacedreader

# LLM — Ollama (default)
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:3b
OPENAI_TIMEOUT_SECONDS=120.0
OLLAMA_MODEL=qwen2.5:3b

# LLM — OpenAI (alternative, uncomment and remove OPENAI_BASE_URL)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# App
APP_BACKEND_URL=http://backend:8000
